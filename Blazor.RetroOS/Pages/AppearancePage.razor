@page "/appearance"

<PageTitle>Appearance</PageTitle>

<div class="demo-grid">
    <RetroWindow Title="Appearance" ShowCloseButton="false">
        <h1>Appearance</h1>
        <p>
            Every component has an Appearance parameter. It applies to the component and to everything
            inside it, and can be changed at any time. Without it, a component takes the look of its parents.
        </p>
        <pre class="demo-code">&lt;link href="_content/BlazorRetroOS/css/retroos.css" rel="stylesheet" /&gt;

&lt;RetroWindow Title="Disk" Appearance="appearance"&gt;
    &lt;RetroButton&gt;OK&lt;/RetroButton&gt;
&lt;/RetroWindow&gt;</pre>
    </RetroWindow>

    <RetroWindow Title="This window only" Appearance="_window" ShowCloseButton="false">
        <p>Appearance of this window:</p>
        @foreach (var appearance in Enum.GetValues<Appearance>())
        {
            <RetroButton Default="@(appearance == _window)" OnClick="() => _window = appearance">@MainLayout.AppearanceName(appearance)</RetroButton>
        }
        <RetroCheckBox Checked="true" Text="Its children follow" />
        <RetroProgressBar Value="60" Style="margin-top: 8px;" />
    </RetroWindow>

    <RetroWindow Title="Mixed" ShowCloseButton="false" Active="false">
        <p>One component with its own appearance:</p>
        @foreach (var appearance in Enum.GetValues<Appearance>())
        {
            <RetroButton Appearance="appearance">@MainLayout.AppearanceName(appearance)</RetroButton>
        }
    </RetroWindow>

    <RetroWindow Title="Stylesheets" ShowCloseButton="false" Active="false">
        <table class="demo-table">
            <thead>
                <tr><th>Appearance</th><th>Alone (static sites)</th><th>Class</th></tr>
            </thead>
            <tbody>
                @foreach (var appearance in Enum.GetValues<Appearance>())
                {
                    <tr><td>@appearance</td><td>@appearance.ToFileName()</td><td>@appearance.ToCssClass()</td></tr>
                }
            </tbody>
        </table>
        <p>CSS variables, usable in your own styles whatever the appearance:</p>
        <ul>
            @foreach (var variable in RetroCss.Variables)
            {
                <li><code>@variable</code></li>
            }
        </ul>
    </RetroWindow>
</div>

@code {
    private Appearance _window = Appearance.AtariST;
}
