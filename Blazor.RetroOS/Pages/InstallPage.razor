@page "/install"

<PageTitle>Installation</PageTitle>

<RetroWindow Title="Installation" ShowCloseButton="false">
    <h1>Installation</h1>

    <p>Add the package:</p>
    <CodeBlock Code="@PackageCode" Language="CodeLanguage.Powershell" EnableLineNumbers="false" />

    <p>In _Imports.razor:</p>
    <CodeBlock Code="@ImportsCode" Language="CodeLanguage.Razor" EnableLineNumbers="false" />

    <p>In index.html (or App.razor), the stylesheet with all the appearances:</p>
    <CodeBlock Code="@StylesheetCode" Language="CodeLanguage.Html" EnableLineNumbers="false" />

    <p>Then choose the look with the Appearance parameter, on any component (its children follow), and change it whenever you want:</p>
    <CodeBlock Code="@ScreenCode" Language="CodeLanguage.Razor" EnableLineNumbers="false" />

    <p>Without Appearance, the components use the default look (Workbench 1.3).</p>

    <p><i>Not using Blazor? The looks are also available for static sites (HTML, PHP...): see <a href="static-css">Static sites</a>.</i></p>
</RetroWindow>

@code {
    private const string PackageCode = "dotnet add package BlazorRetroOS";
    private const string ImportsCode = "@using Blazor.RetroOS.Components";
    private const string StylesheetCode = """<link href="_content/BlazorRetroOS/css/retroos.css" rel="stylesheet" />""";
    private const string ScreenCode = """<RetroScreen Title="My app" Appearance="Appearance.AtariST">...</RetroScreen>""";
}
