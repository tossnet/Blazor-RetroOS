@page "/components"

<PageTitle>Components</PageTitle>

<div class="demo-grid">
    <RetroWindow Title="Buttons" ShowCloseButton="false">
        <RetroButton Default="true" OnClick="() => _clicks++">OK</RetroButton>
        <RetroButton OnClick="() => _clicks++">Cancel</RetroButton>
        <RetroButton Disabled="true">Disabled</RetroButton>
        <p>Clicks: @_clicks</p>
        <CodeBlock Code="@ButtonCode" Language="CodeLanguage.Razor" EnableLineNumbers="false" />
    </RetroWindow>

    <RetroWindow Title="CheckBox" ShowCloseButton="false" Active="false">
        <RetroCheckBox @bind-Checked="_checked" Text="Show all files" />
        <br />
        <RetroCheckBox Checked="true" Disabled="true" Text="Disabled" />
        <p>Checked: @_checked</p>
        <CodeBlock Code="@CheckBoxCode" Language="CodeLanguage.Razor" EnableLineNumbers="false" />
    </RetroWindow>

    <RetroWindow Title="TextBox" ShowCloseButton="false" Active="false">
        <RetroTextBox Label="Name" @bind-Value="_name" Placeholder="Your name" />
        <br />
        <RetroTextBox Label="Disk" Value="DF0:" Disabled="true" />
        <p>Hello @_name</p>
        <CodeBlock Code="@TextBoxCode" Language="CodeLanguage.Razor" EnableLineNumbers="false" />
    </RetroWindow>

    <RetroWindow Title="ProgressBar" ShowCloseButton="false" Active="false">
        <RetroProgressBar Value="_progress" />
        <RetroButton OnClick="() => _progress = (_progress + 20) % 120">Step</RetroButton>
        <CodeBlock Code="@ProgressBarCode" Language="CodeLanguage.Razor" EnableLineNumbers="false" />
    </RetroWindow>

    <RetroWindow Title="Disabled window" Disabled="true" ShowCloseButton="false" Active="false">
        <p>Disabled is cascaded to the controls of the window.</p>
        <RetroButton>OK</RetroButton>
        <RetroCheckBox Text="Option" />
    </RetroWindow>
</div>

@code {
    private int _clicks;
    private bool _checked = true;
    private string? _name = "Bob";
    private double _progress = 40;

    private const string ButtonCode = """<RetroButton Default="true" OnClick="...">OK</RetroButton>""";
    private const string CheckBoxCode = """<RetroCheckBox @bind-Checked="value" Text="..." />""";
    private const string TextBoxCode = """<RetroTextBox Label="Name" @bind-Value="name" />""";
    private const string ProgressBarCode = """<RetroProgressBar Value="40" Max="100" />""";
}
