@namespace Blazor.RetroOS.Components

@inherits RetroComponentBase

<label class="@RootClass(RetroCss.CheckBox)" style="@Style" @attributes="Attributes">
    <input type="checkbox"
           id="@Id"
           class="@RetroCss.CheckBoxInput"
           checked="@Checked"
           disabled="@IsDisabled"
           @onchange="OnChangeAsync" />
    <span>@if (ChildContent is not null) { @ChildContent } else { @Text }</span>
</label>
